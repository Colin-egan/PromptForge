# PromptForge Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# ============================================================================
# IBM watsonx.ai Configuration (REQUIRED)
# ============================================================================
# Get these from: https://cloud.ibm.com/
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================================================
# Model Configuration
# ============================================================================
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
GRANITE_TEMPERATURE=0.2
GRANITE_MAX_TOKENS=2048
GRANITE_TOP_P=0.95

# ============================================================================
# Backend API Configuration (Railway)
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CORS - Add your Vercel domain here
CORS_ORIGINS=https://promptforge.vercel.app,https://*.vercel.app

# ============================================================================
# Chroma Vector Database (Railway Internal)
# ============================================================================
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=promptforge_examples

# ============================================================================
# Docker Sandbox Configuration
# ============================================================================
SANDBOX_IMAGE=promptforge-sandbox:latest
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2

# ============================================================================
# Frontend Configuration (Vercel)
# ============================================================================
# This should be your Railway backend URL
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app

# ============================================================================
# Optional: Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ============================================================================
# Optional: Monitoring & Analytics
# ============================================================================
ENABLE_TELEMETRY=false
SENTRY_DSN=