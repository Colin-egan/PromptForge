# Docker ignore file - exclude unnecessary files from Docker builds

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.cache/

# Data and databases (exclude from image, mount as volumes)
data/
*.sqlite3
*.db

# Test files
tests/
**/__tests__/
**/*.test.py
**/*.test.ts
**/*.test.tsx
coverage/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
dist/
build/
*.egg

